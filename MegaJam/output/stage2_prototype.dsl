(event EventBeginPlay
  (Development|PrintString :InString "STAGE 2 TEST | A/D MOVE | Q SHADOW | B BLOOM | N EXPOSURE\nF/G MOVE PIECE A | H/J MOVE PIECE B\n1/2/3 SYMBOLS | 4/5/6 FILMS | 7/8/9 ANSWERS | ENTER SUBMIT" :Duration 120.0))
(event EventTick
  (bind pc (Game|GetPlayerController 0))
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Q")
    (Stage2|Rendering|SetShadowsEnabled :self self :bEnabled (not (Variables|Stage2|State|GetShadowsOn)))
    (Development|PrintString :InString "SHADOW TOGGLED" :Duration 2.0))
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "B")
    (Stage2|Rendering|SetBloomEnabled :self self :bEnabled (not (Variables|Stage2|State|GetBloomOn)))
    (Development|PrintString :InString "BLOOM TOGGLED" :Duration 2.0))
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "N")
    (Stage2|Rendering|SetDarkExposure :self self :bDark (not (Variables|Stage2|State|GetExposureDark)))
    (Development|PrintString :InString "EXPOSURE TOGGLED" :Duration 2.0))
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "F")
    (Stage2|Shadow|MoveShadowPiece :self self :Piece (Variables|Stage2|Shadow|GetShadowPieceA) :DeltaX -50.0 :RailMinX 200.0 :RailMaxX 1000.0))
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "G")
    (Stage2|Shadow|MoveShadowPiece :self self :Piece (Variables|Stage2|Shadow|GetShadowPieceA) :DeltaX 50.0 :RailMinX 200.0 :RailMaxX 1000.0))
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "H")
    (Stage2|Shadow|MoveShadowPiece :self self :Piece (Variables|Stage2|Shadow|GetShadowPieceB) :DeltaX -50.0 :RailMinX 600.0 :RailMaxX 1100.0))
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "J")
    (Stage2|Shadow|MoveShadowPiece :self self :Piece (Variables|Stage2|Shadow|GetShadowPieceB) :DeltaX 50.0 :RailMinX 600.0 :RailMaxX 1100.0))
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "One") (Stage2|Sequence|EnterSymbol :self self :Symbol "Star") (Development|PrintString :InString "STAR" :Duration 2.0))
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Two") (Stage2|Sequence|EnterSymbol :self self :Symbol "Moon") (Development|PrintString :InString "MOON" :Duration 2.0))
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Three") (Stage2|Sequence|EnterSymbol :self self :Symbol "Sun") (Development|PrintString :InString "SUN" :Duration 2.0))
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Four") (Stage2|Film|SelectFilm :self self :Film "A") (Development|PrintString :InString "FILM A: BLOOM OFF" :Duration 3.0))
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Five") (Stage2|Film|SelectFilm :self self :Film "B") (Development|PrintString :InString "FILM B: SHADOW OFF" :Duration 3.0))
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Six") (Stage2|Film|SelectFilm :self self :Film "C") (Development|PrintString :InString "FILM C: DARK EXPOSURE" :Duration 3.0))
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Seven") (Variables|Default|SetTestScene (not (Variables|Default|GetTestScene))) (Development|PrintString :InString "SCENE: 3 / 1 TOGGLED" :Duration 2.0))
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Eight") (Variables|Default|SetTestDirection (not (Variables|Default|GetTestDirection))) (Development|PrintString :InString "DIRECTION: RIGHT / LEFT TOGGLED" :Duration 2.0))
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Nine") (Variables|Default|SetTestMark (not (Variables|Default|GetTestMark))) (Development|PrintString :InString "MARK: GEAR / STAR TOGGLED" :Duration 2.0))
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "Enter")
    (if (and (and (Variables|Default|GetTestScene) (Variables|Default|GetTestDirection)) (Variables|Default|GetTestMark))
      (Stage2|Film|SubmitFilmSolution :self self :SceneNumber 3 :Direction "Right" :Mark "Gear")
      (Development|PrintString :InString "FILM PUZZLE COMPLETE" :Duration 5.0)
      (else (Stage2|Film|SubmitFilmSolution :self self :SceneNumber 1 :Direction "Left" :Mark "Star")
        (Development|PrintString :InString "INCORRECT - TRY 7/8/9" :Duration 3.0))))
  (if (Game|Player|WasInputKeyJustPressed :self pc :Key "P")
    (if (Variables|Stage2|State|GetShadowSolved) (Development|PrintString :InString "SHADOW SOLVED" :Duration 3.0) (else (Development|PrintString :InString "SHADOW NOT SOLVED" :Duration 3.0)))
    (if (Variables|Stage2|State|GetSequenceSolved) (Development|PrintString :InString "SYMBOLS SOLVED" :Duration 3.0) (else (Development|PrintString :InString "SYMBOLS NOT SOLVED" :Duration 3.0)))
    (if (Stage2|Film|IsCurrentFilmClueVisible :self self) (Development|PrintString :InString "FILM CLUE VISIBLE" :Duration 3.0) (else (Development|PrintString :InString "FILM CLUE HIDDEN" :Duration 3.0)))))
