(event EventBeginPlay
  (Variables|Default|SetWheelX 440.0)
  (Variables|Default|SetWheelDirection 1.0)
  (Variables|Default|SetIsLow true)
  (Variables|Default|SetMenuOpen false)
  (Variables|Default|SetWheelSolved false)
  (Variables|Default|SetLiftAlpha 0.0)
  (Variables|Default|SetLiftActive false)
  (Variables|Default|SetLiftSolved false)
  (Variables|Default|SetLiftDescending false)
  (bind liftVisuals (Actor|GetAllActorswithTag :Tag "LiftVisual"))
  (for liftVisual liftVisuals (Collision|SetActorEnableCollision :self liftVisual :bNewActorEnableCollision false))
  (bind w (UserInterface|CreateWidget :Class "/Game/Stage1Generated/WBP_Stage1Settings.WBP_Stage1Settings_C" :OwningPlayer (Game|GetPlayerController 0)))
  (Variables|Default|SetSettingsWidget w)
  (UserInterface|Viewport|AddtoViewport :self w :ZOrder 10)
  (Widget|SetVisibility :self w :InVisibility "Collapsed")
  (bind hi (Actor|GetAllActorswithTag :Tag "StageHigh"))
  (for a hi (Rendering|SetActorHiddenInGame :self a :bNewHidden true))
  (bind lo (Actor|GetAllActorswithTag :Tag "StageLow"))
  (for a lo (Rendering|SetActorHiddenInGame :self a :bNewHidden false))
  (Development|PrintString :InString "A/D: MOVE | ESC: SETTINGS | Q: QUICK QUALITY | E: LIFT" :Duration 12.0))
(event EventTick (DeltaSeconds)
  (bind pc (Game|GetPlayerController :PlayerIndex 0))
  (Variables|Default|SetQualityChanged false)
  (if (or (Game|Player|WasInputKeyJustPressed :self pc :Key "Escape") (Game|Player|WasInputKeyJustPressed :self pc :Key "M"))
    (Variables|Default|SetMenuOpen (not (Variables|Default|GetMenuOpen)))
    (if (Variables|Default|GetMenuOpen)
      (Widget|SetVisibility :self (Variables|Default|GetSettingsWidget) :InVisibility "Visible")
      (Input|SetIgnoreMoveInput :self pc :bNewMoveInput true)
      (else
        (Widget|SetVisibility :self (Variables|Default|GetSettingsWidget) :InVisibility "Collapsed")
        (Input|SetIgnoreMoveInput :self pc :bNewMoveInput false))))
  (if (and (Variables|Default|GetMenuOpen) (Game|Player|WasInputKeyJustPressed :self pc :Key "One"))
    (Variables|Default|SetIsLow true)
    (Variables|Default|SetQualityChanged true))
  (if (and (Variables|Default|GetMenuOpen) (Game|Player|WasInputKeyJustPressed :self pc :Key "Two"))
    (Variables|Default|SetIsLow false)
    (Variables|Default|SetQualityChanged true))
  (if (and (not (Variables|Default|GetMenuOpen)) (Game|Player|WasInputKeyJustPressed :self pc :Key "Q"))
    (Variables|Default|SetIsLow (not (Variables|Default|GetIsLow)))
    (Variables|Default|SetQualityChanged true))
  (if (and (Variables|Default|GetMenuOpen) (Game|Player|WasInputKeyJustPressed :self pc :Key "Three"))
    (Variables|Default|SetShadowOff (not (Variables|Default|GetShadowOff)))
    (if (Variables|Default|GetShadowOff)
      (Development|ExecuteConsoleCommand :Command "r.ShadowQuality 0" :SpecificPlayer pc)
      (else (Development|ExecuteConsoleCommand :Command "r.ShadowQuality 3" :SpecificPlayer pc))))
  (if (Variables|Default|GetQualityChanged)
    (bind isLowChanged (Variables|Default|GetIsLow))
    (bind highs (Actor|GetAllActorswithTag :Tag "StageHigh"))
    (for a highs (Rendering|SetActorHiddenInGame :self a :bNewHidden isLowChanged))
    (bind lows (Actor|GetAllActorswithTag :Tag "StageLow"))
    (for a lows (Rendering|SetActorHiddenInGame :self a :bNewHidden (not isLowChanged)))
    (if isLowChanged
      (Development|PrintString :InString "MODEL QUALITY: LOW" :Duration 2.0)
      (else (Development|PrintString :InString "MODEL QUALITY: HIGH" :Duration 2.0))))
  (if (and (and (not (Variables|Default|GetIsLow)) (not (Variables|Default|GetWheelSolved))) (not (Variables|Default|GetMenuOpen)))
    (Variables|Default|SetWheelX (+ (Variables|Default|GetWheelX) (* (* DeltaSeconds 100.0) (Variables|Default|GetWheelDirection))))
    (if (> (Variables|Default|GetWheelX) 1420.0) (Variables|Default|SetWheelDirection -1.0))
    (if (< (Variables|Default|GetWheelX) 440.0) (Variables|Default|SetWheelDirection 1.0)))
  (bind wx (Variables|Default|GetWheelX))
  (bind low (Variables|Default|GetIsLow))
  (bind wheels (Actor|GetAllActorswithTag :Tag "WheelPiece"))
  (for wheel wheels
    (Transformation|SetActorLocationAndRotation :self wheel
      :NewLocation (Math|Vector|MakeVector :X wx :Y 0.0 :Z (select (< wx 1000.0) (- 184.2 (* wx 0.08)) 100.0))
      :NewRotation (Math|Rotator|MakeRotator :Pitch (select low 0.0 (* (- wx 440.0) -0.572958)))
      :bSweep false :bTeleport true))
  (if (and (and low (not (Variables|Default|GetWheelSolved))) (and (> wx 1110.0) (< wx 1320.0)))
    (Variables|Default|SetWheelSolved true)
    (bind gates (Actor|GetAllActorswithTag :Tag "StageGate"))
    (for gate gates
      (Rendering|SetActorHiddenInGame :self gate :bNewHidden true)
      (Collision|SetActorEnableCollision :self gate :bNewActorEnableCollision false))
    (bind gateVisuals (Actor|GetAllActorswithTag :Tag "StageGateVisual"))
    (for gate gateVisuals
      (Transformation|SetActorLocation :self gate :NewLocation (Math|Vector|MakeVector :X 1860.0 :Y -164.0 :Z 497.0) :bSweep false :bTeleport true))
    (Development|PrintString :InString "WHEEL PUZZLE COMPLETE - GATE OPEN" :Duration 5.0))
  (if (and (not (Variables|Default|GetMenuOpen)) (Game|Player|WasInputKeyJustPressed :self pc :Key "E"))
    (bind pawn (Game|GetPlayerPawn :PlayerIndex 0))
    (bind loc (Transformation|GetActorLocation :self pawn))
    (if (and (> (.x loc) 8585.0) (< (.x loc) 8800.0))
      (if (and (> (.z loc) (+ (Variables|Default|GetLiftAlpha) 90.0)) (< (.z loc) (+ (Variables|Default|GetLiftAlpha) 150.0)))
        (if low
          (Development|PrintString :InString "GEAR SLIPS - SET MODEL QUALITY TO HIGH" :Duration 3.0)
          (else
            (if (not (Variables|Default|GetLiftActive))
              (Variables|Default|SetLiftDescending (> (Variables|Default|GetLiftAlpha) 115.0))
              (Variables|Default|SetLiftActive true)
              (Input|SetIgnoreMoveInput :self pc :bNewMoveInput true)
              (Development|PrintString :InString "GEAR ENGAGED - LIFT MOVING" :Duration 3.0))))
        (else (Development|PrintString :InString "STAND ON THE LIFT TO OPERATE IT" :Duration 3.0)))
      (else
        (if (and (> (.x loc) 8350.0) (< (.x loc) 9000.0))
          (Development|PrintString :InString "STAND IN THE CENTER OF THE LIFT AND PRESS E" :Duration 3.0)))))
  (if (and (and (Variables|Default|GetLiftActive) (not low)) (not (Variables|Default|GetMenuOpen)))
    (if (Variables|Default|GetLiftDescending)
      (Variables|Default|SetLiftAlpha (- (Variables|Default|GetLiftAlpha) (* DeltaSeconds 55.0)))
      (else (Variables|Default|SetLiftAlpha (+ (Variables|Default|GetLiftAlpha) (* DeltaSeconds 55.0)))))
    (if (<= (Variables|Default|GetLiftAlpha) 0.0)
      (Variables|Default|SetLiftAlpha 0.0)
      (Input|SetIgnoreMoveInput :self pc :bNewMoveInput false)
      (Variables|Default|SetLiftActive false))
    (if (>= (Variables|Default|GetLiftAlpha) 230.0)
      (Variables|Default|SetLiftAlpha 230.0)
      (Input|SetIgnoreMoveInput :self pc :bNewMoveInput false)
      (Variables|Default|SetLiftActive false)
      (Variables|Default|SetLiftSolved true))
    (bind liftZ (Variables|Default|GetLiftAlpha))
    (bind visuals (Actor|GetAllActorswithTag :Tag "LiftVisual"))
    (for a visuals (Transformation|SetActorLocation :self a :NewLocation (Math|Vector|MakeVector :X 8700.0 :Y 0.0 :Z (+ 15.0 liftZ)) :bSweep false :bTeleport false))
    (bind colliders (Actor|GetAllActorswithTag :Tag "LiftCollider"))
    (for a colliders (Transformation|SetActorLocation :self a :NewLocation (Math|Vector|MakeVector :X 8700.0 :Y 0.0 :Z (+ 22.0 liftZ)) :bSweep false :bTeleport false))))
